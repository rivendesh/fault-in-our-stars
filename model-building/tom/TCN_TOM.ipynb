    "class FocalLoss(nn.Module):\n",
    "    def __init__(self, alpha=None, gamma=1.5):\n",
    "        super().__init__()\n",
    "        self.alpha = alpha\n",
    "        self.gamma = gamma\n",
    "\n",
    "    def forward(self, logits, targets):\n",
    "        ce = F.cross_entropy(logits, targets, weight=self.alpha, reduction=\"none\")\n",
    "        pt = torch.exp(-ce)\n",
    "        loss = ((1.0 - pt) ** self.gamma) * ce\n",
